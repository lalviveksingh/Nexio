# ─────────────────────────────────────────────────────────────
# NEXIO website configuration. Copy to `.env.local` and fill in.
# NEVER commit real credentials. All values below are placeholders.
# ─────────────────────────────────────────────────────────────

# Public site URL (used for metadata)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Public contact details (shown on the site; leave blank until confirmed) ──
# TODO(client): supply verified values. Blank = shown as "To be confirmed".
NEXT_PUBLIC_CONTACT_PHONE=
NEXT_PUBLIC_CONTACT_EMAIL=
# Digits only, with country code, e.g. 91XXXXXXXXXX
NEXT_PUBLIC_WHATSAPP_NUMBER=
NEXT_PUBLIC_BUSINESS_ADDRESS=
NEXT_PUBLIC_BUSINESS_HOURS=
NEXT_PUBLIC_SOCIAL_LINKEDIN=
NEXT_PUBLIC_SOCIAL_INSTAGRAM=
NEXT_PUBLIC_SOCIAL_FACEBOOK=
NEXT_PUBLIC_SOCIAL_YOUTUBE=

# ── Server-only email delivery (SMTP). Never prefix these with NEXT_PUBLIC_ ──
# Until ALL of SMTP_HOST, SMTP_USER, SMTP_PASS and ENQUIRY_TO_EMAIL are set,
# the form shows an honest "email delivery is not set up yet" message.
SMTP_HOST=
SMTP_PORT=587
# "true" for port 465 (implicit TLS); "false" for 587 (STARTTLS)
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# Inbox that receives website enquiries
ENQUIRY_TO_EMAIL=
# Sender address (must be allowed by your SMTP provider). Defaults to SMTP_USER.
ENQUIRY_FROM_EMAIL=
